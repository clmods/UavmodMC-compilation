name: Build mod

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Unzip project
        run: |
          set -e
          ZIP=$(find . -maxdepth 2 -name '*.zip' -not -path './.git/*' | head -n 1)
          if [ -z "$ZIP" ]; then
            echo "::error::В репозитории не найден .zip файл с модом"
            exit 1
          fi
          echo "Распаковываю: $ZIP"
          mkdir -p _unpacked
          unzip -q -o "$ZIP" -d _unpacked

          GRADLE_FILE=$(find _unpacked -name build.gradle -not -path '*/__MACOSX/*' | head -n 1)
          if [ -z "$GRADLE_FILE" ]; then
            echo "::error::В архиве нет build.gradle"
            exit 1
          fi
          PROJECT_DIR=$(dirname "$GRADLE_FILE")
          echo "Проект: $PROJECT_DIR"
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Set up Gradle 7.3.3
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 7.3.3

      - name: Build
        run: |
          cd "$PROJECT_DIR"
          gradle build --no-daemon --stacktrace

      - name: Collect jar
        run: |
          mkdir -p dist
          cp "$PROJECT_DIR"/build/libs/*.jar dist/
          rm -f dist/*-sources.jar dist/*-dev.jar
          ls -la dist

      - name: Upload mod jar
        uses: actions/upload-artifact@v4
        with:
          name: uavwarfare-mod
          path: dist/*.jar
